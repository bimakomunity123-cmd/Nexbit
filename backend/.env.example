# Copy this file to .env (gitignored) and fill in real values before
# running anywhere beyond your own machine.

# Generate a real one: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRES_MINUTES=60

# SQLite by default. For Postgres: postgresql+psycopg2://user:pass@host/dbname
DATABASE_URL=sqlite:///./nexbit.db

# Comma-separated exact-match origins allowed to call this API.
CORS_ORIGINS=https://bimakomunity123-cmd.github.io
